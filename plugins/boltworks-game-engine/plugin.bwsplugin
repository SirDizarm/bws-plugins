{"kind":"boltworks-plugin-package","packageVersion":1,"manifest":{"kind":"boltworks-plugin","manifestVersion":1,"id":"boltworks-game-engine","name":"BoltWorks Game Engine","version":"1.1.0","description":"Experimental character ZIP and arm GLB exporter, with image-to-solid sword and shield generation. Requires BWS v50.0.17+. Explicitly share a character copy; downloads and adding items require your click. Validation is pending.","runtime":"sandbox-html","entry":"main.html","apiVersion":4,"enabled":false,"dependencies":[],"contributes":{"characterSnapshot":true,"characterExport":true,"generatedGameItem":true,"exporters":["glb","bws-character"]}},"files":{"main.html":{"mediaType":"text/html","data":"<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>BoltWorks Game Engine</title><style>body{font:14px Verdana,sans-serif;background:#142125;color:#e3eeea;margin:0;padding:20px;line-height:1.6}button,input,select{font:inherit;border:1px solid #4a635e;border-radius:5px;background:#223638;color:#edf7f3;padding:8px;box-sizing:border-box}button{cursor:pointer}button:disabled{opacity:.45;cursor:default}label{display:flex;gap:8px;align-items:center}.field-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:8px}select{max-width:100%;min-width:0;flex:1}.compact-row{display:flex;flex-wrap:wrap;gap:10px;margin:10px 0}.section-header{display:none}.api-note{color:#b6cec6}hr{border:0;border-top:1px solid #35524d;margin:24px 0}#preview{width:100%;height:360px;overflow:hidden}input[type=number]{width:85px}</style></head><body><h1>BoltWorks Game Engine</h1><p>Experimental extracted plugin. Send a character copy using the BWS header. Exports are prepared here; save them using <strong>Download export</strong> in that header.</p>        <section class=\"section collapsed\" id=\"gameEnginePluginSection\" data-plugin-id=\"boltworks-game-engine\" data-collapse-persist=\"boltworks-game-engine\">\n          <button class=\"section-header\" id=\"gameEnginePluginToggle\" type=\"button\" aria-expanded=\"false\" aria-controls=\"gameEnginePluginBody\"><h2>BoltWorks Game Engine</h2><span class=\"plugin-ready\">Layered GLB</span></button>\n          <div class=\"section-body\" id=\"gameEnginePluginBody\">\n            <p class=\"api-note\">Exports one Raylib-ready skinned character with explicit lower-body and upper-body tracks. Every clip contains every bone at 24 FPS; unused bones stay at bind pose and root motion stays disabled.</p>\n            <div class=\"field-grid game-engine-clip-map\">\n              <label>Lower Idle<select data-game-engine-clip=\"Lower_Idle\"><option value=\"\">Choose source clip</option></select></label>\n              <label>Lower Walk<select data-game-engine-clip=\"Lower_Walk\"><option value=\"\">Choose source clip</option></select></label>\n              <label>Lower Run<select data-game-engine-clip=\"Lower_Run\"><option value=\"\">Choose source clip</option></select></label>\n              <label>Lower Jump<select data-game-engine-clip=\"Lower_Jump\"><option value=\"\">Choose source clip</option></select></label>\n              <label>Upper Idle<select data-game-engine-clip=\"Upper_Idle\"><option value=\"\">Choose source clip</option></select></label>\n              <label>Upper Slash<select data-game-engine-clip=\"Upper_Slash\"><option value=\"\">Choose source clip</option></select></label>\n              <label>Upper Thrust<select data-game-engine-clip=\"Upper_Thrust\"><option value=\"\">Choose source clip</option></select></label>\n              <label>Upper Block<select data-game-engine-clip=\"Upper_Block\"><option value=\"\">Choose source clip</option></select></label>\n            </div>\n            <div class=\"compact-row\">\n              <button id=\"gameEngineAutoMapBtn\" type=\"button\">Auto-map Clips</button>\n              <button id=\"gameEngineValidateBtn\" type=\"button\">Validate Character</button>\n            </div>\n            <label class=\"toggle-chip\" title=\"Include full, medium, and low polygon versions in the engine package. The editable project is not changed.\">\n              <input id=\"gameCharacterLodInput\" type=\"checkbox\" checked /> <span>Include LODs (full / medium / low)</span>\n            </label>\n            <button id=\"exportGameCharacterBtn\" class=\"primary\" type=\"button\" title=\"Export the layered skinned GLB, manifest, clip list, sockets, and optional LODs for BoltWorks Game Engine / Raylib\">Export Layered Game Character</button>\n            <hr />\n            <strong>First-person Arms</strong>\n            <p class=\"api-note\">Export only the selected skinned arm geometry with the same skeleton and clips. Held equipment is always omitted.</p>\n            <div class=\"compact-row\">\n              <label style=\"flex:1\">Arms <select id=\"gameArmExportSideInput\"><option value=\"both\">Both arms</option><option value=\"left\">Left arm</option><option value=\"right\">Right arm</option></select></label>\n              <button id=\"exportGameArmsBtn\" type=\"button\" title=\"Export arm-only skinned geometry without weapons or shields\">Export Arms GLB</button>\n            </div>\n            <hr />\n            <strong>Image Item to Solid 3D</strong>\n            <p class=\"api-note\">Turn sword or shield art into a thick, socket-ready model. Swords receive a raised diamond ridge; shields receive a textured front, wood back, and metal edge/rim.</p>\n            <div class=\"compact-row\">\n              <button id=\"gameItemImageBtn\" type=\"button\">Choose Item Image</button>\n              <span id=\"gameItemImageName\" class=\"api-note\">No image selected</span>\n              <input id=\"gameItemImageFile\" type=\"file\" accept=\"image/*,.png,.jpg,.jpeg,.webp\" hidden />\n            </div>\n            <div class=\"compact-row\">\n              <label style=\"flex:1\">Item <select id=\"gameItemTypeInput\"><option value=\"sword\">Sword / blade</option><option value=\"shield\">Shield</option></select></label>\n              <label style=\"flex:1\">Height <input id=\"gameItemHeightInput\" type=\"number\" min=\"0.25\" max=\"20\" step=\"0.25\" value=\"4\" /></label>\n              <label style=\"flex:1\">Thickness <input id=\"gameItemThicknessInput\" type=\"number\" min=\"0.02\" max=\"2\" step=\"0.02\" value=\"0.24\" /></label>\n            </div>\n            <button id=\"gameItemBuildBtn\" type=\"button\" disabled>Build Solid Item</button>\n            <p id=\"gameItemBuildStatus\" class=\"api-note\">Choose an image to begin.</p>\n            <p id=\"gameEngineExportStatus\" class=\"api-note\">Map the eight required clips, then validate the character.</p>\n          </div>\n        </section>\n<label>Medium LOD detail (%) <input id=\"gameOptimizeRatioInput\" type=\"number\" min=\"20\" max=\"90\" value=\"65\"></label><h2>Item preview</h2><div id=\"preview\"></div><script>(()=>{var bi={LEFT:0,MIDDLE:1,RIGHT:2,ROTATE:0,DOLLY:1,PAN:2},Si={ROTATE:0,PAN:1,DOLLY_PAN:2,DOLLY_ROTATE:3},wf=0,uh=1,Ef=2;var ud=1,Af=2,wn=3,Xn=0,kt=1,Yt=2,Hn=0,es=1,dh=2,fh=3,ph=4,Tf=5,di=100,Rf=101,Cf=102,Pf=103,If=104,Lf=200,Uf=201,Nf=202,Df=203,nc=204,ic=205,Of=206,Ff=207,Bf=208,zf=209,kf=210,Vf=211,Hf=212,Gf=213,Wf=214,Xf=0,qf=1,Yf=2,lo=3,$f=4,Zf=5,Kf=6,Jf=7,Yo=0,jf=1,Qf=2,Gn=0,ep=1,tp=2,np=3,ip=4,sp=5,rp=6,op=7,mh=\"attached\",ap=\"detached\",Tl=300,mi=301,gi=302,ho=303,uo=304,dr=306,os=1e3,un=1001,as=1002,Et=1003,$o=1004;var pi=1005;var zt=1006,ts=1007;var dn=1008;var qn=1009,cp=1010,lp=1011,fo=1012,dd=1013,cs=1014,Jt=1015,Zo=1016,fd=1017,pd=1018,ls=1020,hp=35902,up=1021,dp=1022,Bt=1023,fp=1024,pp=1025,ns=1026,hs=1027,md=1028,gd=1029,mp=1030,_d=1031,xd=1033,fa=33776,pa=33777,ma=33778,ga=33779,gh=35840,_h=35841,xh=35842,yh=35843,vh=36196,Mh=37492,bh=37496,Sh=37808,wh=37809,Eh=37810,Ah=37811,Th=37812,Rh=37813,Ch=37814,Ph=37815,Ih=37816,Lh=37817,Uh=37818,Nh=37819,Dh=37820,Oh=37821,_a=36492,Fh=36494,Bh=36495,